# Supabase 대시보드 → Project Settings → API 에서 복사
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않음)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# (선택) 대표 계정 아이디 뒤에 붙는 도메인. 기본 lfc.team → lfc1 입력 시 lfc1@lfc.team 으로 로그인
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=lfc.team

# (선택) AI 보고서 다듬기용 Anthropic API 키 — 서버 전용. NEXT_PUBLIC_ 붙이지 말 것. Vercel 에서는 Secret 타입으로
ANTHROPIC_API_KEY=
